# Keep staging non-indexed. Change only for the verified public production site.
SITE_ENV=staging
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reserved for a later Sanity integration.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional only if the existing dataset is private. Never expose a write token.
SANITY_API_READ_TOKEN=

# Optional privacy-friendly analytics script. Loaded only when SITE_ENV=production.
NEXT_PUBLIC_ANALYTICS_SRC=
